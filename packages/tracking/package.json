{
  "name": "@interstellar-tools/tracking",
  "version": "0.0.0",
  "description": "Satellite and space probe tracking: orbital elements, SGP4 propagation, ground tracks, look angles and passes, and positions of deep-space probes.",
  "keywords": [
    "satellite-tracking",
    "satellites",
    "tle",
    "omm",
    "sgp4",
    "sdp4",
    "orbit-propagation",
    "ground-track",
    "look-angles",
    "satellite-passes",
    "iss",
    "space-probes",
    "ephemeris",
    "lagrange-points",
    "orbit-decay",
    "astrodynamics",
    "orbital-mechanics",
    "space",
    "typescript",
    "javascript",
    "interstellar-tools"
  ],
  "homepage": "https://phun-ky.net/interstellar-tools/",
  "bugs": {
    "url": "https://github.com/phun-ky/interstellar-tools/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phun-ky/interstellar-tools.git"
  },
  "funding": "https://github.com/phun-ky/interstellar-tools?sponsor=1",
  "license": "MIT",
  "author": "Alexander Vassbotn Røyne-Helgesen <alexander@phun-ky.net>",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "clean": "rm -rf dist *.tsbuildinfo",
    "typecheck": "tsc -p tsconfig.json",
    "release": "release-it",
    "test": "tsx --test **/__tests__/**/*.spec.ts",
    "pretest:ci": "rm -rf coverage && mkdir -p coverage",
    "test:ci": "glob-bin -c \"node --import tsx --test --no-warnings --experimental-test-coverage --test-coverage-include='src/**' --test-coverage-exclude='**/__tests__/**' --test-coverage-lines=99.9 --test-coverage-branches=99.1 --test-coverage-functions=100 --test-reporter=cobertura --test-reporter-destination=coverage/cobertura-coverage.xml --test-reporter=spec --test-reporter-destination=stdout\" \"**/__tests__/**/*.spec.ts\""
  },
  "dependencies": {
    "@interstellar-tools/constants": "^1.2.0",
    "@interstellar-tools/equations": "^1.11.0",
    "@interstellar-tools/maps": "^0.11.0",
    "@interstellar-tools/temporal": "^1.1.0",
    "@interstellar-tools/types": "^1.6.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "fast-check": "4.10.2",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.9.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
