{
  "name": "@interstellar-tools/mcp",
  "version": "1.0.0",
  "description": "Model Context Protocol (MCP) server exposing interstellar-tools orbital mechanics equations and celestial body datasets to AI assistants.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "interstellar",
    "tools",
    "astrodynamics",
    "orbital-mechanics",
    "celestial-mechanics",
    "kepler",
    "hohmann-transfer",
    "delta-v",
    "vis-viva",
    "planets",
    "moons",
    "interstellar-tools"
  ],
  "homepage": "https://phun-ky.net/interstellar-tools/",
  "bugs": {
    "url": "https://github.com/phun-ky/interstellar-tools/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phun-ky/interstellar-tools.git"
  },
  "funding": "https://github.com/phun-ky/interstellar-tools?sponsor=1",
  "license": "MIT",
  "author": "Alexander Vassbotn Røyne-Helgesen <alexander@phun-ky.net>",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "interstellar-tools-mcp": "dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rm -rf dist *.tsbuildinfo",
    "typecheck": "tsc -p tsconfig.json",
    "release": "release-it",
    "start": "node dist/bin.js",
    "test": "tsx --test **/__tests__/**/*.spec.ts",
    "pretest:ci": "rm -rf coverage && mkdir -p coverage",
    "test:ci": "glob-bin -c \"node --import tsx --test --no-warnings --experimental-test-coverage --test-reporter=cobertura --test-reporter-destination=coverage/cobertura-coverage.xml --test-reporter=spec --test-reporter-destination=stdout\" \"**/__tests__/**/*.spec.ts\""
  },
  "dependencies": {
    "@interstellar-tools/constants": "^1.0.0",
    "@interstellar-tools/equations": "^1.0.0",
    "@interstellar-tools/temporal": "^1.0.0",
    "@interstellar-tools/types": "^1.0.0",
    "@modelcontextprotocol/sdk": "1.31.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.9.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
