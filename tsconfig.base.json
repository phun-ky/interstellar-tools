// tsconfig.base.json
{
  "compilerOptions": {
    "target": "ES2020",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["ES2020"],
    "declaration": true,
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "composite": true, // required for project references
    "paths": {
      "@interstellar-tools/equations": ["./packages/equations/src"],
      "@interstellar-tools/types": ["./packages/types/src"],
      "@interstellar-tools/temporal": ["./packages/temporal/src"],
      "@interstellar-tools/constants": ["./packages/constants/src"]
    }
  },
  "exclude": ["node_modules", "dist"]
}
